# Copy this file to .env and fill in real values.
# NEVER commit the real .env file - it is already excluded via .gitignore.

# ============================================
# CORE APP
# ============================================
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=postgresql://user:password@localhost:5432/bizspark
FLASK_ENV=development
FLASK_DEBUG=1
BASE_URL=http://localhost:5000
APP_NAME=MichiePlus
APP_VERSION=1.0

# ============================================
# PAYSTACK
# ============================================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
OAUTHLIB_INSECURE_TRANSPORT=1

# ============================================
# EMAIL (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM=your-email@example.com

# ============================================
# BOT PROTECTION: CLOUDFLARE TURNSTILE
# ============================================
# Get these from the Cloudflare dashboard: Turnstile > Add a site
# TURNSTILE_SITE_KEY is safe to expose in the frontend.
# TURNSTILE_SECRET_KEY must NEVER be committed or exposed client-side -
# it is only ever read server-side via os.environ.get().
#
# In production (FLASK_ENV=production), leaving TURNSTILE_SECRET_KEY unset
# will cause all Turnstile-protected forms (login, signup, password reset,
# OTP, admin login/setup) to fail closed and reject requests, rather than
# silently allowing them through.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ============================================
# RATE LIMITING (optional)
# ============================================
# By default, Flask-Limiter stores counters in-process memory, which is
# fine for a single-process deployment but does NOT share state across
# multiple gunicorn workers/dynos on Render. For multi-worker production
# deployments, point this at a shared Redis instance instead, e.g.:
#   RATELIMIT_STORAGE_URI=redis://:password@your-redis-host:6379/0
RATELIMIT_STORAGE_URI=memory://
